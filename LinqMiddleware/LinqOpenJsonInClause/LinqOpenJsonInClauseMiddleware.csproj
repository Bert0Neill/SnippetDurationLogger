<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageIcon>performanceIcon.png</PackageIcon>
    <PackageReadmeFile>ReadMe.md</PackageReadmeFile>
    <Title>EF Core 6\7 OpenJson Middleware Boost Large Contains Statements</Title>
    <Authors>Bert O'Neill, Dani Rubio</Authors>
    <RunAnalyzersDuringLiveAnalysis>True</RunAnalyzersDuringLiveAnalysis>
    <PackageTags>Entiry framework Core 6, Entiry framework Core 7, EF Core 6 &amp; 7, Improve LINQ Performance, Large Contains</PackageTags>
    <PackageProjectUrl></PackageProjectUrl>
    <RepositoryUrl>https://github.com/Bert0Neill/LinqMiddleware</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>To vastly improve Linq queries that need to use a large volume of values within their Contains statement (200K+).
By using Parallel looping and ConcurrentBags, you can execute multiple database request with larger volumes of values within your Contains by using the updated middleware.</Description>
    <PackageId>Linq.OpenJson.InClause.Middleware</PackageId>
    <Version>1.0.14</Version>
    <PackageLicenseFile>MIT-LICENSE.txt</PackageLicenseFile>
    <PackageReleaseNotes>Accounting for varchar conversion using N.
For e.g. [l].[Team]) NOT IN (N'Finn', N'Harps', N'FC') </PackageReleaseNotes>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="7.0.19" />
  </ItemGroup>

  <ItemGroup>
    <None Update="MIT-LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="performanceIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>  
  </ItemGroup>

  <ItemGroup>
    <None Include="ReadMe.md" Pack="True" PackagePath="\" />
  </ItemGroup>


</Project>
