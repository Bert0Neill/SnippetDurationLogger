<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <ApplicationIcon>LogTime.ico</ApplicationIcon>
    <Description>A quick way to measure the execution time of a specific code block, without timing the entire function.</Description>
    <PackageIcon>istockphoto-2153758709-1024x1024.jpg</PackageIcon>
    <Authors>Bert O'Neill</Authors>
    <PackageReadmeFile>ReadMe.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Bert0Neill/SnippetDurationLogger</RepositoryUrl>
    <PackageTags>Code Benchmark;Duration Logger;Code Snippet Time;</PackageTags>
    <PackageLicenseFile>MIT-LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="LogTime.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="C:\Users\owner\Downloads\istockphoto-2153758709-1024x1024.jpg">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="MIT-LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="ReadMe.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
